# ==========================================
# Triage Service — .dockerignore
# Excludes files not needed for this service
# ==========================================

# Version control
.git
.gitignore

# Dependencies (installed during build)
node_modules

# Build output (generated during build)
dist

# Environment & secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode

# Logs
*.log

# Docs
*.md
LICENSE

# OS files
.DS_Store
Thumbs.db

# Temp files
.temp
.tmp

# Test coverage
coverage
.nyc_output

# Other microservices (not needed for this build)
apps/api-gateway
apps/patients
apps/users
apps/ehr

# Prisma from other services
apps/api-gateway/prisma
apps/patients/prisma
apps/users/prisma
apps/ehr/prisma

# Prisma migrations & seed (not needed at runtime)
prisma/migrations
prisma/seed.ts

# Kubernetes
kubernetes

# ESLint cache
.eslintcache
