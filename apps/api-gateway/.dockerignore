# ==========================================
# API Gateway — .dockerignore
# Excludes files not needed for this service
# ==========================================

# Version control
.git
.gitignore

# Dependencies (installed during build)
node_modules

# Build output (generated during build)
dist

# Environment & secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode

# Logs
*.log

# Docs
*.md
LICENSE

# OS files
.DS_Store
Thumbs.db

# Temp files
.temp
.tmp

# Test coverage
coverage
.nyc_output

# Other microservices (not needed for this build)
apps/patients
apps/users
apps/triage
apps/ehr

# Prisma (not used by api-gateway)
apps/*/prisma

# Kubernetes
kubernetes

# ESLint cache
.eslintcache
